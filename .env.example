# Copie para .env e ajuste os valores — NUNCA commite .env com credenciais reais

PORT=4050
SITES_ROOT=/app/sites
DATA_DIR=/app/data

ADMIN_USER=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte
SESSION_SECRET=troque-por-um-segredo-longo-aleatorio

MAX_UPLOAD_MB=50
PUBLIC_DOMAIN=https://sites.seudominio.com

RSYNC_SSH_HOST=servidor.seudominio.com
RSYNC_LOCAL_PATH=/caminho/local/selfhost-website
RSYNC_REMOTE_PATH=/opt/selfhost-website
RSYNC_REMOTE_SITES=/opt/selfhost-website/sites
